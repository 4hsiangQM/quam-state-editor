{
  "name": "quam-state-editor",
  "publisher": "jackchao",
  "displayName": "QuAM State Editor",
  "description": "Edit calibration parameters in state.json",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "quam-state-editor.open",
        "title": "Open Panel",
        "category": "QuAM State Editor"
      },
      {
        "command": "quam-state-editor.openQuickPick",
        "title": "Open (Quick Pick)",
        "category": "QuAM State Editor"
      },
      {
        "command": "quam-state-editor.selectStateFile",
        "title": "Select state.json",
        "category": "QuAM State Editor"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.105.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
